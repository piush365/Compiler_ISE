// if / else, while, && || ! and relational operators
n = 10;
i = 0;
sum = 0;
while (i < n && !(i == 7)) {
    if (i % 2 == 0 || i > 8) {
        sum = sum + i * 2;
    } else {
        sum = sum - 1;
    }
    i = i + 1;
}
avg = sum / 2.5 + sqrt(n);
ok = sum > 5 && avg != 0;
print(sum);
print(avg);
print(ok);
